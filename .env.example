# Environment Configuration for MServerController

# NOTE: If you're using the install.sh script, it will automatically 
# prompt you for these values and create the .env file for you.
# This file serves as a template for manual configuration.

# ==================== REQUIRED FOR PRODUCTION ====================

# Secret key for session encryption (MUST BE RANDOM AND SECURE)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# Flask environment (development or production)
FLASK_ENV=production

# Allowed CORS origins for SocketIO (comma-separated, required in production)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ==================== OPTIONAL CONFIGURATION ====================

# Port to run the server on (default: 3000)
PORT=3000

# Session cookie domain (for subdomain support)
# SESSION_COOKIE_DOMAIN=yourdomain.com

# Session lifetime in seconds (default: 604800 = 7 days)
# PERMANENT_SESSION_LIFETIME=604800

# ==================== DEVELOPMENT ONLY ====================

# In development, you can use:
# FLASK_ENV=development
# ALLOWED_ORIGINS can be omitted in development (allows all origins)

# ==================== SECURITY NOTES ====================

# 1. NEVER commit this file with real secrets to version control
# 2. Generate a unique SECRET_KEY for each environment
# 3. In production, always set FLASK_ENV=production
# 4. Set ALLOWED_ORIGINS to your actual domain(s) in production
# 5. Use HTTPS in production (SESSION_COOKIE_SECURE is auto-enabled)
