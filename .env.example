# Environment Configuration for MServer
#
# This file is the CANONICAL TEMPLATE for configuration. The installer
# (install.sh) copies it to `.env`, generates a SECRET_KEY, and forces a couple
# of prod-safe values — it does NOT prompt interactively. To tailor an install,
# edit the values here (before installing) or in the generated `.env` (after),
# then restart the service.
#
# Every key below is read by the app with a matching built-in default, so an
# uncommented key simply pins that default explicitly. Commented (#) keys fall
# back to the code default.

# ==================== REQUIRED FOR PRODUCTION ====================

# Secret key for session encryption (MUST BE RANDOM AND SECURE).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# The installer replaces this placeholder with a freshly generated key.
SECRET_KEY=your-random-secret-key-here

# Flask environment (development or production). Keep "production" for installs.
FLASK_ENV=production

# ==================== NETWORK / SESSION ====================

# Port to run the server on.
PORT=3000

# Comma-separated allowed WebSocket/CORS origins (use * to allow all).
# Example: CORS_ORIGINS=https://panel.example.com,https://example.com
CORS_ORIGINS=*

# Secure-cookie flag. Defaults to true on install: the app runs HTTP behind a
# reverse proxy that terminates TLS and forwards X-Forwarded-Proto=https. Set to
# false only if you expose the panel over plain HTTP directly (not recommended).
SESSION_COOKIE_SECURE=true

# Session lifetime in seconds (default: 604800 = 7 days).
PERMANENT_SESSION_LIFETIME=604800

# Session cookie domain, for sharing across subdomains (e.g. .example.com).
# Leave unset for a single-host install.
# SESSION_COOKIE_DOMAIN=example.com

# Real-time (SocketIO) ping tuning, in seconds. Raise the timeout for
# high-latency networks/proxies.
SOCKETIO_PING_INTERVAL=25
SOCKETIO_PING_TIMEOUT=60

# Global request rate limit (Flask-Limiter syntax). Tighten for public panels.
RATE_LIMIT_DEFAULT=100 per 15 minutes

# Per-connection throttling on the console 'command' and 'subscribe' SocketIO
# events (Flask-Limiter only covers HTTP routes, not SocketIO). Each pair is
# "N events per M seconds" for a single socket connection.
SOCKET_COMMAND_RATE_LIMIT=20
SOCKET_COMMAND_RATE_WINDOW_SECONDS=10
SOCKET_SUBSCRIBE_RATE_LIMIT=30
SOCKET_SUBSCRIBE_RATE_WINDOW_SECONDS=10

# ==================== SERVERS / JAVA ====================

# Default JVM args applied to newly created/imported Java servers.
# Tune to the host's available RAM (e.g. -Xmx8G -Xms2G).
DEFAULT_JAVA_ARGS=-Xmx4G -Xms1G

# Java executable used to launch Java servers. A bare name is resolved on PATH;
# set an absolute path to pin a specific JDK (e.g. /usr/lib/jvm/java-21/bin/java).
JAVA_BINARY=java

# ==================== STORAGE PATHS ====================
# Relative values resolve against the app directory; absolute paths are used
# as-is. Use these to place servers/backups/database on a separate volume.
# NOTE: changing these on an existing install does NOT move existing data —
# stop the service and move the directories/DB yourself first.

# Directory holding per-server data (also the trusted containment root for
# per-server file operations).
# SERVERS_DIR=servers

# Directory holding backups.
# BACKUPS_DIR=backups

# SQLite database file. NEVER point this at a non-MServer file.
# DB_PATH=msc.db

# ==================== LIMITS / RETENTION ====================

# Max upload size in gigabytes (large world ZIPs).
MAX_UPLOAD_SIZE_GB=25

# Max per-server resource pack upload size in megabytes.
MAX_RESOURCEPACK_SIZE_MB=100

# Days of system stats history (CPU/RAM/disk) to retain.
STATS_RETENTION_DAYS=7

# Pending-MFA login window in seconds (how long after password entry the TOTP
# code stays valid).
MFA_TIMEOUT_SECONDS=300

# ==================== SECURITY NOTES ====================
# 1. NEVER commit a real `.env` with secrets to version control.
# 2. Generate a unique SECRET_KEY per environment.
# 3. Keep FLASK_ENV=production and SESSION_COOKIE_SECURE=true behind a TLS proxy.
# 4. Restrict CORS_ORIGINS to your domain(s) for production.
